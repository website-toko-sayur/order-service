# =========================
# APP
# =========================
APP_PORT=8082
APP_ENV=development
APP_NAME=product-service
WEB_PREFORK=false
LOG_LEVEL=debug
JWT_SECRET_KEY=super-secret-key
GATEWAY_SECRET_KEY=veggo-gateway-secret-key
REQUEST_API_GATEWAY=true
INTERNAL_SECRET_KEY=veggo-internal-secret-key
SERVER_TIMEOUT=30
PRODUCT_SERVICE_URL=http://localhost:8082
USER_SERVICE_URL=http://localhost:8090
LATITUDE_REF=
LONGITUDE_REF=
MAX_DISTANCE=

# =========================
# DATABASE
# =========================
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=root
DATABASE_PASSWORD=root_password
DATABASE_NAME=veggo_product_service
DATABASE_MAX_OPEN_CONNECTION=25
DATABASE_MAX_IDLE_CONNECTION=10

# =========================
# KAFKA
# =========================
KAFKA_AUTO_OFFSET_RESET=earliest
KAFKA_BOOTSTRAP_SERVERS=localhost:19092
KAFKA_GROUP_ID=veggo-product-service-group
KAFKA_PRODUCER_ENABLED=true

# =========================
# TOPIC
# =========================
TOPIC_PRODUCT_UPDATE_STOCK="product-update-stock"
TOPIC_ORDER_PUBLISH="order-publish"
TOPIC_EMAIL_UPDATE_STATUS="email-update-status-order"
TOPIC_DELETE_ORDER="delete-order"
TOPIC_PAYMENT_SUCCESS="payment-success"
TOPIC_UPDATE_STATUS_ORDER="update-status-order"

# =========================
# REDIS
# =========================
REDIS_HOST=localhost
REDIS_PORT=6380
REDIS_PASSWORD=password

# =========================
# OPENSEARCH
# =========================
OPENSEARCH_HOST=http://localhost:9200
OPENSEARCH_USERNAME=admin
OPENSEARCH_PASSWORD=OpenSearch#2026Dev
